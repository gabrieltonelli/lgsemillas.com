# ==============================================================================
# VARIABLES DE ENTORNO DEL FRONTEND — LG SEMILLAS (client/.env.template)
# ==============================================================================
# Copia este archivo como `client/.env` para ejecutar `npm run dev` en `client/`.
# SEGURIDAD CRÍTICA: Toda variable con prefijo `VITE_` es embebida en el bundle
# público del navegador. NUNCA agregues contraseñas, tokens privados ni claves API
# secretas en este archivo.
# ==============================================================================

# --- Conexión al Backend ---
# En desarrollo local con proxy Vite usa `/api`. En Netlify usa `/api` (redirigido a Netlify Functions).
VITE_API_BASE_URL=/api

# Destino del proxy de desarrollo de Vite (solo entorno local)
VITE_DEV_PROXY_TARGET=http://localhost:4580

# Puerto local del servidor de desarrollo Vite (ej. 5580)
VITE_DEV_PORT=5580

