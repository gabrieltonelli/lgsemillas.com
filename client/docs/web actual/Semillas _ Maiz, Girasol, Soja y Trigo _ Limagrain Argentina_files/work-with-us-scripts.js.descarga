function processWorkWithUsForm(action, method, data) {
    $.ajax({
    	url: action,
    	type: method,
    	data: data,
    	dataType: 'json',
    	cache: false,
    	contentType: false,
    	processData: false,
    	beforeSend: function() {
            $('#work-with-us-button').prop('disabled', true);
            $('#work-with-us-button').val('PROCESANDO...');
    	},
    	success: function(response) {
            if (response.success) {
                swal({
	                title: 'Mensaje', 
	                text: response.message, 
	                type: 'success'
	            }).then(function() {
	            	window.location.href = '/';
	            });
            } else {
                swal({
	                title: 'Error', 
	                text: response.message, 
	                type: 'error'
	            });
            }

            $('#work-with-us-button').prop('disabled', false);
            $('#work-with-us-button').val('ENVIAR');
    	},
    	error: function(xhr) {

    		swal({
                title: 'Ups', 
                text: xhr.responseText, 
                type: 'warning'
            });
            
            $('#work-with-us-button').prop('disabled', false);
            $('#work-with-us-button').val('ENVIAR');
    	}
    });
}

$(document).on('submit', '#work-with-us-form', function(event) {
	event.preventDefault();

	var action = $(this).attr('action'),
	method = $(this).attr('method'),
	data = new FormData(this);

	processWorkWithUsForm(action, method, data);
});