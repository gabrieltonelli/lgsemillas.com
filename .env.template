# ==============================================================================
# VARIABLES DE ENTORNO DE ORQUESTACIÓN (DOCKER COMPOSE / MONOREPO ROOT)
# ==============================================================================
# Copia este archivo como `.env` antes de ejecutar `docker compose up --build`.
# IMPORTANTE: No coloques credenciales reales en variables VITE_* del frontend.
# ==============================================================================

# --- Puertos expuestos en el host local ---
# Puerto público para el frontend Nginx en Docker (ej. http://localhost:8580)
CLIENT_DOCKER_PORT=8580

# Puerto público para el backend Node/Express en Docker (ej. http://localhost:4580)
SERVER_DOCKER_PORT=4580

# --- Build del cliente dentro de Docker ---
# Ruta relativa para que Nginx proxee `/api` hacia el contenedor `server`
DOCKER_VITE_API_BASE_URL=/api

# Nombre institucional mostrado en la web
DOCKER_VITE_SITE_NAME=LG Semillas — Limagrain Argentina

# --- Configuración del backend en Docker ---
# Origen permitido para CORS (ajusta si cambias el dominio o puerto del cliente)
DOCKER_CORS_ORIGIN=http://localhost:8580

