# ==============================================================================
# VARIABLES DE ENTORNO DEL BACKEND — LG SEMILLAS (server/.env.template)
# ==============================================================================
# Copia este archivo como `server/.env` para desarrollo local (`npm run dev`).
# SEGURIDAD: Estas variables son exclusivas del backend. NUNCA las expongas
# hacia el cliente ni las devuelvas en endpoints HTTP públicos.
# ==============================================================================

# --- Servidor HTTP ---
# Puerto de escucha del servidor Express (ej. 4580)
PORT=4580

# Entorno de ejecución: development | production | test
NODE_ENV=development

# Prefijo base de las rutas API (ej. /api)
API_PREFIX=/api

# --- Seguridad y CORS ---
# Lista separada por comas de orígenes permitidos (ej. http://localhost:5580,https://www.lgsemillas.com)
CORS_ORIGIN=http://localhost:5580,http://localhost:8580

# Ventana de rate-limiting en milisegundos (ej. 900000 = 15 minutos)
RATE_LIMIT_WINDOW_MS=900000

# Cantidad máxima de peticiones por IP dentro de la ventana
RATE_LIMIT_MAX_REQUESTS=150

# --- Parametrización Institucional Pública (servida de forma segura en /api/company) ---
COMPANY_NAME=LG Semillas — Limagrain Argentina
COMPANY_GROUP=Limagrain Field Seeds
COMPANY_EMAIL=lgsemillas@limagrain.com
COMPANY_PHONE=+54 2477 430000
COMPANY_WHATSAPP=+5492477430000
COMPANY_ADDRESS=Ruta 32 Km. 2, (2700) Pergamino, Provincia de Buenos Aires, Argentina
ETHICS_CHANNEL_URL=https://www.limagrain.com/en/ethics-and-compliance

# --- Credenciales Privadas (SOLO BACKEND - NUNCA EXPONER AL FRONTEND) ---
# Servidor SMTP para envío real de consultas comerciales y postulaciones
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notificaciones@lgsemillas.com
SMTP_PASS=reemplazar_clave_smtp_privada_solo_backend

# Destinatarios internos de formularios
CONTACT_RECIPIENT_EMAIL=lgsemillas@limagrain.com
CAREERS_RECIPIENT_EMAIL=rrhh.argentina@limagrain.com

# Token secreto para webhook hacia CRM interno / ERP comercial
CRM_API_KEY=reemplazar_token_crm_privado_solo_backend
CRM_WEBHOOK_SECRET=reemplazar_webhook_secret_solo_backend

